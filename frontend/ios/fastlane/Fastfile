# Nest iOS 배포 레인.
#
# 인증: App Store Connect API 키(.p8) — 2FA 없는 완전 비대화식.
#   ios/fastlane/.env 에 설정 (.env.example 참고):
#     ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH, FASTLANE_TEAM_ID
#
# 레인:
#   fastlane ios build     — 서명된 릴리스 IPA 빌드만 (업로드 없음)
#   fastlane ios beta      — 빌드 + TestFlight 업로드
#   fastlane ios release   — 빌드 + 업로드 + 프로덕션 심사 제출(기존 메타데이터 재사용)
#   fastlane ios submit    — 이미 업로드된 빌드를 심사 제출만
#
# 버전은 pubspec.yaml의 `version: X.Y.Z+BUILD`를 그대로 쓴다.
# 스토어 업로드 전마다 BUILD를 올려야 한다 (docs/mobile_release.md §6).

default_platform(:ios)

# fastlane(Ruby)는 프로세스 시작 시점의 셸 로케일로 기본 인코딩을 정한다.
# 셸 LANG이 비어 있으면 default_external이 US-ASCII가 되어, 한국어 메타데이터를
# 읽어 String#strip 할 때 Encoding::CompatibilityError가 난다(.env의 LANG은
# dotenv 로딩이 인코딩 확정보다 늦어 소용없다). 여기서 UTF-8을 강제해 deliver의
# 메타데이터 파일 읽기가 항상 UTF-8이 되게 한다.
Encoding.default_external = Encoding::UTF_8 if Encoding.default_external != Encoding::UTF_8
require "fileutils"
require "shellwords"

# Xcode 26 altool은 같은 prefix의 다른 앱으로 업로드가 새는 버그가 있다.
# Nest의 App Store Connect 숫자 ID를 명시하고, 가능하면 레거시 uploader를 쓴다.
ENV["DELIVER_ALTOOL_ADDITIONAL_UPLOAD_PARAMETERS"] ||=
  "--apple-id 6760330123 --use-old-altool --bundle-id com.lionandthelab.nest"

FLUTTER_ROOT = File.expand_path("../..", __dir__)
BUNDLE_ID = "com.lionandthelab.nest"
EXPORT_OPTIONS = File.join(FLUTTER_ROOT, "ios", "ExportOptions.plist")

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    duration: 1200,
    in_house: false,
  )
end

def pubspec_version
  # 로케일과 무관하게 UTF-8로 읽는다(pubspec에 한국어 주석 존재).
  version = File.read(File.join(FLUTTER_ROOT, "pubspec.yaml"), encoding: "UTF-8")[/^version:\s*(\S+)/, 1]
  UI.user_error!("pubspec.yaml에서 version을 읽지 못했습니다") if version.to_s.empty?
  name, build = version.split("+")
  [name, build.to_i]
end

# API 키로 App Store 배포 프로파일을 받아(없으면 포털에 생성) 수동 서명을
# 구성하고 릴리스 IPA를 빌드한다. 반환값: IPA 경로.
def flutter_build_ipa(api_key)
  get_provisioning_profile(
    api_key: api_key,
    app_identifier: BUNDLE_ID,
    platform: "ios",
    readonly: false,
    filename: "Nest_AppStore.mobileprovision",
  )
  profile_name = lane_context[SharedValues::SIGH_NAME]
  team = ENV.fetch("FASTLANE_TEAM_ID")

  update_code_signing_settings(
    use_automatic_signing: false,
    path: File.join(FLUTTER_ROOT, "ios", "Runner.xcodeproj"),
    team_id: team,
    targets: ["Runner"],
    code_sign_identity: "Apple Distribution",
    bundle_identifier: BUNDLE_ID,
    profile_name: profile_name,
  )

  File.write(EXPORT_OPTIONS, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key><string>app-store</string>
      <key>destination</key><string>export</string>
      <key>signingStyle</key><string>manual</string>
      <key>teamID</key><string>#{team}</string>
      <key>provisioningProfiles</key>
      <dict>
        <key>#{BUNDLE_ID}</key>
        <string>#{profile_name}</string>
      </dict>
      <key>uploadSymbols</key><true/>
      <key>stripSwiftSymbols</key><true/>
    </dict>
    </plist>
  PLIST

  Dir.chdir(FLUTTER_ROOT) do
    # fastlane의 Ruby 환경(GEM_HOME 등)이 flutter의 CocoaPods 검사를 깨뜨리므로
    # 관련 변수를 비우고 실행한다.
    sh("env", "-u", "RUBYOPT", "-u", "RUBYLIB", "-u", "GEM_HOME", "-u", "GEM_PATH",
       "-u", "BUNDLE_GEMFILE", "-u", "BUNDLE_BIN_PATH", "-u", "BUNDLE_PATH",
       "flutter", "build", "ipa", "--release",
       "--export-options-plist=#{EXPORT_OPTIONS}")
  end
  archive = File.join(FLUTTER_ROOT, "build", "ios", "archive", "Runner.xcarchive")
  if File.directory?(archive)
    # path_provider_foundation 2.6+ 가 넣는 objective_c native asset이
    # 기기 아카이브에서도 LC_BUILD_VERSION=IOSSIMULATOR로 남는 경우가 있다.
    # Apple 91169로 거절되므로 xcarchive에서 고친 뒤 재수출(재서명)한다.
    patched = patch_objective_c_framework!(archive)
    reexport_ipa!(archive) if patched
  end
  latest_ipa
end

def latest_ipa
  ipa = Dir.glob(File.join(FLUTTER_ROOT, "build", "ios", "ipa", "*.ipa"))
           .max_by { |f| File.mtime(f) }
  UI.user_error!("build/ios/ipa/ 아래에 IPA가 생성되지 않았습니다") unless ipa
  ipa
end

def patch_objective_c_framework!(archive_path)
  fw = File.join(
    archive_path,
    "Products/Applications/Runner.app/Frameworks/objective_c.framework/objective_c",
  )
  return false unless File.exist?(fw)

  changed = false
  archs = `lipo -archs #{fw.shellescape}`.to_s
  if archs.include?("x86_64")
    sh("lipo", "-remove", "x86_64", fw, "-output", "#{fw}.tmp")
    File.rename("#{fw}.tmp", fw)
    changed = true
  end

  show = `vtool -show-build #{fw.shellescape}`
  if show.include?("IOSSIMULATOR") || !show.match?(/platform IOS\b/)
    sdk = `xcrun --sdk iphoneos --show-sdk-version`.to_s.strip
    sdk = "18.0" if sdk.empty?
    sh("vtool", "-set-build-version", "ios", "15.0", sdk, "-replace",
       "-output", "#{fw}.tmp", fw)
    File.rename("#{fw}.tmp", fw)
    changed = true
    UI.success("objective_c.framework 플랫폼 태그를 iOS #{sdk}로 고쳤습니다")
  end

  plist = File.join(File.dirname(fw), "Info.plist")
  if File.exist?(plist)
    current = `/usr/libexec/PlistBuddy -c 'Print :MinimumOSVersion' #{plist.shellescape}`.to_s.strip
    if current != "15.0"
      system("/usr/libexec/PlistBuddy", "-c", "Set :MinimumOSVersion 15.0", plist) ||
        sh("/usr/libexec/PlistBuddy", "-c", "Add :MinimumOSVersion string 15.0", plist)
      changed = true
      UI.success("objective_c.framework MinimumOSVersion을 15.0으로 맞췄습니다 (was #{current})")
    end
  end
  changed
end

def reexport_ipa!(archive_path)
  ipa_dir = File.join(FLUTTER_ROOT, "build", "ios", "ipa")
  FileUtils.mkdir_p(ipa_dir)
  sh(
    "xcodebuild",
    "-exportArchive",
    "-archivePath", archive_path,
    "-exportPath", ipa_dir,
    "-exportOptionsPlist", EXPORT_OPTIONS,
  )
end

# 업로드 전에 pubspec 빌드 넘버가 TestFlight 최신보다 큰지 확인한다.
def assert_build_number_fresh!(api_key)
  _, build = pubspec_version
  latest = begin
    latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID)
  rescue StandardError
    0
  end
  return if build > latest.to_i

  UI.user_error!(
    "pubspec version의 빌드 넘버(+#{build})가 TestFlight 최신 빌드(#{latest})보다 커야 " \
    "합니다. pubspec.yaml의 version을 올린 뒤 다시 실행하세요.",
  )
end

platform :ios do
  desc "스토어 상태 조회 (라이브 버전 / TestFlight 최신 빌드)"
  lane :status do
    api_key = asc_key
    version, build = pubspec_version
    tf = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID)
    rescue StandardError => e
      "조회 실패(#{e.message.lines.first&.strip})"
    end
    live = begin
      app_store_build_number(api_key: api_key, live: true, app_identifier: BUNDLE_ID)
      "#{lane_context[SharedValues::LATEST_VERSION]} (#{lane_context[SharedValues::LATEST_BUILD_NUMBER]})"
    rescue StandardError
      "라이브 버전 없음"
    end
    UI.important("pubspec: #{version}+#{build} | TestFlight 최신 빌드: #{tf} | App Store 라이브: #{live}")
  end

  desc "이미 있는 xcarchive의 objective_c 시뮬레이터 태그를 고치고 IPA를 다시 보낸다"
  lane :repair_archive do
    archive = File.join(FLUTTER_ROOT, "build", "ios", "archive", "Runner.xcarchive")
    UI.user_error!("xcarchive가 없습니다: #{archive}") unless File.directory?(archive)
    patched = patch_objective_c_framework!(archive)
    UI.important(patched ? "framework를 고쳤습니다. IPA를 다시 보냅니다." : "고칠 내용이 없습니다. IPA를 다시 보냅니다.")
    reexport_ipa!(archive)
    UI.success("재수출 완료: #{latest_ipa}")
  end

  desc "서명된 릴리스 IPA 빌드만 (업로드 없음)"
  lane :build do
    ipa = flutter_build_ipa(asc_key)
    UI.success("빌드 완료: #{ipa}")
  end

  desc "메타데이터/스크린샷만 업로드 (바이너리·심사 제출 없음)"
  lane :metadata do
    upload_to_app_store(
      api_key: asc_key,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true,
    )
    UI.success("메타데이터/스크린샷 업로드 완료")
  end

  desc "이미 빌드된 IPA를 프로덕션 심사 제출 (options: ipa). 빌드는 다시 하지 않는다"
  lane :release_upload do |options|
    api_key = asc_key
    ipa = options[:ipa] || latest_ipa
    version, build = pubspec_version
    upload_to_app_store(
      api_key: api_key,
      ipa: ipa,
      app_version: version,
      submit_for_review: true,
      automatic_release: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
    UI.success("프로덕션 심사 제출 완료: #{version} (#{build}) — 승인 시 자동 출시")
  end

  desc "이미 빌드된 IPA를 TestFlight에 업로드만 (options: ipa)"
  lane :upload do |options|
    api_key = asc_key
    ipa = options[:ipa] ||
          Dir.glob(File.join(FLUTTER_ROOT, "build", "ios", "ipa", "*.ipa"))
             .max_by { |f| File.mtime(f) }
    UI.user_error!("build/ios/ipa/ 아래에 IPA가 없습니다 — 먼저 build 레인을 실행하세요") unless ipa
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
    )
    UI.success("TestFlight 업로드 완료: #{ipa}")
  end

  desc "빌드 + TestFlight 업로드"
  lane :beta do
    api_key = asc_key
    assert_build_number_fresh!(api_key)
    ipa = flutter_build_ipa(api_key)
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
    )
    version, build = pubspec_version
    UI.success("TestFlight 업로드 완료: #{version} (#{build})")
  end

  desc "빌드 + 업로드 + 프로덕션 심사 제출 (기존 메타데이터/스크린샷 재사용)"
  lane :release do
    api_key = asc_key
    assert_build_number_fresh!(api_key)
    ipa = flutter_build_ipa(api_key)
    version, build = pubspec_version
    upload_to_app_store(
      api_key: api_key,
      ipa: ipa,
      app_version: version,
      submit_for_review: true,
      automatic_release: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
    UI.success("프로덕션 심사 제출 완료: #{version} (#{build}) — 승인 시 자동 출시")
  end

  desc "심사 대기/진행 중인 버전의 상태 조회"
  lane :review_state do
    api_key = asc_key
    Spaceship::ConnectAPI.auth(
      key_id: api_key[:key_id],
      issuer_id: api_key[:issuer_id],
      key: api_key[:key],
    )
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    app.get_app_store_versions.first(4).each do |v|
      UI.important("#{v.version_string} — #{v.app_store_state}")
    end
  end

  desc "심사 대기 중인 버전을 심사에서 내린다 (새 버전을 올리려면 먼저 필요)"
  lane :withdraw do
    api_key = asc_key
    Spaceship::ConnectAPI.auth(
      key_id: api_key[:key_id],
      issuer_id: api_key[:issuer_id],
      key: api_key[:key],
    )
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)

    # WAITING_FOR_REVIEW / IN_REVIEW / PENDING_DEVELOPER_RELEASE 중 하나면
    # 제출을 취소할 수 있다. 취소하면 대기 순번을 잃는다.
    version = app.get_edit_app_store_version || app.get_live_app_store_version
    UI.user_error!("심사 중인 버전을 찾지 못했습니다") if version.nil?

    UI.important("대상: #{version.version_string} (#{version.app_store_state})")
    submission = version.fetch_app_store_version_submission
    if submission.nil?
      UI.important("제출 기록이 없습니다 — 이미 내려가 있습니다")
    else
      submission.delete!
      UI.success("#{version.version_string} 를 심사에서 내렸습니다")
    end
  end

  desc "이미 업로드된 빌드를 심사 제출만 (options: build)"
  lane :submit do |options|
    api_key = asc_key
    version, = pubspec_version
    upload_to_app_store(
      api_key: api_key,
      app_version: version,
      build_number: options[:build],
      submit_for_review: true,
      automatic_release: true,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
    UI.success("심사 제출 완료 — 승인 시 자동 출시")
  end
end
